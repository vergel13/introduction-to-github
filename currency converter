            scanf("%d", &to);
            Beep(500, 300);
        }

        printf("\n\t\t\tEnter amount: ");
        scanf("%f", &amount);
        Beep(500, 300);

        while (amount <= 0)
        {
            printf("\n\t\t\tInvalid input. Please enter a valid amount: ");
            scanf("%f", &amount);
            Beep(500, 300);
        }

        // Perform conversion
